@{
    ViewBag.Title = "Submission Successful";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="form-panel shadow-sm text-center p-4 p-md-5">
            <div class="display-1 text-success" aria-hidden="true">&#10003;</div>
            <h1 class="h2 fw-bold mt-3">Submission Successful</h1>
            <p class="lead text-secondary mt-3">@ViewBag.Message</p>
            <p class="small text-secondary">Thank you for taking the time to share your feedback.</p>
            <div class="mt-4 d-flex flex-wrap justify-content-center gap-2">
                @Html.ActionLink("Back to Home", "Index", "Home", null, new { @class = "btn btn-primary" })
                @Html.ActionLink("Student Feedback", "StudentFeedback", "Feedback", null, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Teacher Feedback", "TeacherFeedback", "Feedback", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    </div>
</div>
