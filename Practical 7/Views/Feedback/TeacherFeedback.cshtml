@model Practical_7.Models.TeacherFeedbackModel
@{
    ViewBag.Title = "Teacher Feedback";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="form-panel shadow-sm p-4 p-md-5">
            <div class="page-kicker mb-2">Teacher form</div>
            <h1 class="h2 fw-bold mb-2">Teacher Feedback</h1>
            <p class="text-secondary mb-4">Share your feedback about teaching and the academic environment.</p>

            @using (Html.BeginForm("TeacherFeedback", "Feedback", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter your full name", autocomplete = "name" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "name@example.com", autocomplete = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Department, new { @class = "form-label fw-semibold" })
                    @Html.DropDownListFor(m => m.Department, (SelectList)ViewBag.Departments, "-- Select Department --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Rating, new { @class = "form-label fw-semibold" })
                    @Html.DropDownListFor(m => m.Rating, (SelectList)ViewBag.Ratings, "-- Select Rating --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Comments, new { @class = "form-label fw-semibold" })
                    @Html.TextAreaFor(m => m.Comments, 5, 40, new { @class = "form-control", placeholder = "Write your comments (10-500 characters)" })
                    @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-success px-4">Submit Feedback</button>
                @Html.ActionLink("Cancel", "Index", "Home", null, new { @class = "btn btn-outline-secondary ms-2" })
            }
        </div>
    </div>
</div>
