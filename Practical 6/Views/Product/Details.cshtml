@model Practical_6.Models.Product
@{
    ViewBag.Title = "Product Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="row g-0">
                <div class="col-md-5">
                    <img src="@Model.ImageUrl" class="img-fluid rounded-start h-100" style="object-fit:cover;" alt="@Model.Name" />
                </div>
                <div class="col-md-7">
                    <div class="card-body">
                        <span class="badge badge-category text-white mb-2">@Model.Category</span>
                        <h3 class="card-title fw-bold">@Model.Name</h3>
                        <p class="price-tag">@Model.Price.ToString("C")</p>
                        <p class="card-text">@Model.Description</p>
                        <p><strong>Stock:</strong> @Model.StockQuantity units</p>
                        <div class="d-flex gap-2 mt-4">
                            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-secondary">
                                <i class="fa-solid fa-pen me-1"></i>Edit
                            </a>
                            <a href="@Url.Action("Delete", new { id = Model.Id })" class="btn btn-danger">
                                <i class="fa-solid fa-trash me-1"></i>Delete
                            </a>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i>Back
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
