@model Practical_6.Models.Product
@{
    ViewBag.Title = "Add New Product";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 p-4">
            <h3 class="fw-bold mb-4"><i class="fa-solid fa-plus me-2"></i>Add New Product</h3>

            @using (Html.BeginForm("Create", "Product", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Price, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Price, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.StockQuantity, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.StockQuantity, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Category, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Category, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.ImageUrl, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Save Product</button>
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
            }
        </div>
    </div>
</div>
