@model Practical_6.Models.Product
@{
    ViewBag.Title = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white fw-bold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>Confirm Delete
            </div>
            <div class="card-body">
                <p>Are you sure you want to delete this product? This action cannot be undone.</p>

                <div class="d-flex align-items-center mb-3">
                    <img src="@Model.ImageUrl" style="width:80px;height:80px;object-fit:cover;" class="rounded me-3" alt="@Model.Name" />
                    <div>
                        <h5 class="mb-0">@Model.Name</h5>
                        <span class="text-muted">@Model.Category &mdash; @Model.Price.ToString("C")</span>
                    </div>
                </div>

                @using (Html.BeginForm("Delete", "Product", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)
                    <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Yes, Delete</button>
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
                }
            </div>
        </div>
    </div>
</div>
